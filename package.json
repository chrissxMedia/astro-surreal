{
  "name": "astro-surreal",
  "engines": {
    "node": ">=22.12.0"
  },
  "version": "0.0.2",
  "description": "Run a bundled Surreal script once for each rendered instance of an Astro component.",
  "license": "MIT",
  "author": "chrissx Media",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrissxMedia/astro-surreal.git"
  },
  "bugs": {
    "url": "https://github.com/chrissxMedia/astro-surreal/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.ts",
      "browser": "./src/helpers.ts",
      "default": "./index.ts"
    },
    "./plugins/props": "./src/plugins/props.ts",
    "./runtime": "./src/runtime.ts"
  },
  "files": [
    "src",
    "index.ts"
  ],
  "keywords": [
    "astro-integration",
    "surreal"
  ],
  "scripts": {
    "test": "node --test test/transform.test.ts",
    "check": "tsc --noEmit",
    "test:browser": "node test/browser.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.5.0",
    "astro": "^7.3.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "astro": "^7.3.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@astrojs/compiler-rs": "^0.4.0",
    "devalue": "^5.9.2",
    "magic-string": "^1.2.3",
    "typescript": "^6.0.3"
  }
}
